<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="CIS 106 PS1p3"/>
        <attribute name="authors" value="kmshi_000"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-03 11:56:15 AM"/>
        <attribute name="created" value="a21zaGlfMDAwO01PTS1BU1VTLTMwMzsyMDI2LTA4LTMwOzEyOjU0OjIzIFBNOzI4NTA="/>
        <attribute name="edited" value="a21zaGlfMDAwO01PTS1BU1VTLTMwMzsyMDI2LTA5LTAzOzExOjU2OjE1IEFNOzM7Mjk0OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Length" type="Real" array="False" size=""/>
            <declare name="Width" type="Real" array="False" size=""/>
            <declare name="Area" type="Real" array="False" size=""/>
            <declare name="Circumference" type="Real" array="False" size=""/>
            <output expression="&quot;Enter the length of the rectangle &quot;" newline="True"/>
            <input variable="Length"/>
            <output expression="&quot;Enter the width of the rectangle &quot;" newline="True"/>
            <input variable="Width"/>
            <assign variable="Area" expression="Length * Width"/>
            <assign variable="Circumference" expression="(2 * Length) + (2 * Width)"/>
            <output expression="&quot;The area of the rectangle in units squared is equal to &quot; &amp;Area" newline="True"/>
            <output expression="&quot;The circumference of the rectangle in units is &quot; &amp;Circumference" newline="True"/>
        </body>
    </function>
</flowgorithm>
