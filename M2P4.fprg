<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="CIS 106 PS1p4"/>
        <attribute name="authors" value="kmshi_000"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-03 11:53:56 AM"/>
        <attribute name="created" value="a21zaGlfMDAwO01PTS1BU1VTLTMwMzsyMDI2LTA4LTMwOzAxOjA3OjE2IFBNOzI4NDg="/>
        <attribute name="edited" value="a21zaGlfMDAwO01PTS1BU1VTLTMwMzsyMDI2LTA5LTAzOzExOjUzOjU2IEFNOzc7Mjk1NA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="LastName" type="String" array="False" size=""/>
            <declare name="Tuition" type="Real" array="False" size=""/>
            <declare name="Credits" type="Real" array="False" size=""/>
            <declare name="TotalTuition" type="Real" array="False" size=""/>
            <output expression="&quot;Please enter your last name &quot;" newline="True"/>
            <input variable="LastName"/>
            <output expression="&quot;How many credits are you taking this semester? &quot;" newline="True"/>
            <input variable="Credits"/>
            <assign variable="Tuition" expression="250 * Credits"/>
            <assign variable="TotalTuition" expression="(Credits * 250) + 100"/>
            <output expression="&quot;Your tuition in dollars is &quot; &amp;Tuition" newline="True"/>
            <output expression="&quot;Student with a last name of &quot; &amp;LastName" newline="True"/>
            <output expression="&quot;Your total tuition with lab fee in dollars is &quot; &amp;TotalTuition" newline="True"/>
        </body>
    </function>
</flowgorithm>
