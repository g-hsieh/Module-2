    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Quantity" type="Real" array="False" size=""/>
            <declare name="unitprice" type="Real" array="False" size=""/>
            <declare name="extprice" type="Real" array="False" size=""/>
            <output expression="&quot;Enter the quantity of computers &quot;" newline="True"/>
            <input variable="Quantity"/>
            <output expression="&quot;Enter the price per unit &quot;" newline="True"/>
            <input variable="unitprice"/>
            <assign variable="extprice" expression="Quantity * Unitprice"/>
            <output expression="&quot;Your Extended Price is $&quot; &amp; extprice" newline="True"/>
        </body>
    </function>
