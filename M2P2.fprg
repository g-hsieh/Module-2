<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="CIS 106 PS1p2"/>
        <attribute name="authors" value="kmshi_000"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-04 01:40:41 PM"/>
        <attribute name="created" value="a21zaGlfMDAwO01PTS1BU1VTLTMwMzsyMDI2LTA4LTI5OzA2OjMyOjMxIFBNOzI4NTY="/>
        <attribute name="edited" value="a21zaGlfMDAwO01PTS1BU1VTLTMwMzsyMDI2LTA5LTA0OzAxOjQwOjQxIFBNOzQ7Mjk1Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Hours" type="Real" array="False" size=""/>
            <declare name="Rate" type="Real" array="False" size=""/>
            <declare name="GrossPay" type="Real" array="False" size=""/>
            <declare name="LastName" type="String" array="False" size=""/>
            <output expression="&quot;Please enter your last name &quot;" newline="True"/>
            <input variable="LastName"/>
            <output expression="&quot;How many hours did you work?&quot;" newline="True"/>
            <input variable="Hours"/>
            <output expression="&quot;What is your hourly rate?&quot;" newline="True"/>
            <input variable="Rate"/>
            <assign variable="GrossPay" expression="Hours * Rate"/>
            <output expression="&quot;Your Gross Pay is a total amount of $&quot; &amp;GrossPay" newline="True"/>
            <output expression="&quot;with a Last Name of &quot; &amp;LastName" newline="True"/>
        </body>
    </function>
</flowgorithm>
